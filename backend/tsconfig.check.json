{
  // Проверка типов по всему репозиторию, включая test/ и prisma/.
  //
  // Основной tsconfig их исключает — он описывает сборку, а в dist этим
  // файлам не место. Из-за этого `tsc --noEmit` по нему молчал про ручные
  // сценарии: изменение сигнатуры сервиса ломало их, а проверка проходила,
  // и обнаруживалось это только при запуске.
  //
  // rootDir поднят до корня: test/ и prisma/ лежат рядом с src/, а не внутри.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "incremental": false
  },
  "include": ["src/**/*", "test/**/*", "prisma/**/*"],
  "exclude": ["node_modules", "dist"]
}
