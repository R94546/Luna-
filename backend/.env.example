# ── База данных ───────────────────────────────────────────────
DATABASE_URL="postgresql://luna:luna@localhost:5432/luna?schema=public"

# ── Redis (очереди BullMQ) ────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ───────────────────────────────────────────────────────
# Сгенерировать: openssl rand -base64 48
JWT_SECRET="ЗАМЕНИТЬ_НА_СЛУЧАЙНУЮ_СТРОКУ_МИНИМУМ_32_СИМВОЛА"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# ── Telegram ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
# Секретный сегмент пути вебхука: openssl rand -hex 16
TELEGRAM_WEBHOOK_SECRET=""
# В dev оставить пустым — бот поднимется в режиме polling
TELEGRAM_WEBHOOK_URL=""

# ── Приложение ────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000
CORS_ORIGINS="http://localhost:3000"
