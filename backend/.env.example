# ── База данных ───────────────────────────────────────────────
DATABASE_URL="postgresql://luna:luna@localhost:5432/luna?schema=public"

# ── Redis ─────────────────────────────────────────────────────
# Пока не используется: Telegram-апдейты обрабатываются синхронно.
# Понадобится, когда появятся фоновые задачи (экспорт отчётов, рассылки).
# Можно не заполнять — сервер запустится и без него.
REDIS_URL=""

# ── JWT ───────────────────────────────────────────────────────
# Обязательно заменить! Сгенерировать в PowerShell:
#   $b = New-Object byte[] 48
#   [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   [Convert]::ToBase64String($b)
JWT_SECRET="ЗАМЕНИТЬ_НА_СЛУЧАЙНУЮ_СТРОКУ_МИНИМУМ_32_СИМВОЛА"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# ── Telegram ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
# Без @ — используется в ссылке привязки t.me/<username>?start=<код>
TELEGRAM_BOT_USERNAME="luna_workshop_bot"
# Секретный сегмент пути вебхука. Нужен только при работе через webhook;
# для локального запуска (polling) можно оставить пустым.
TELEGRAM_WEBHOOK_SECRET=""
# В dev оставить пустым — бот поднимется в режиме polling
TELEGRAM_WEBHOOK_URL=""

# ── Приложение ────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000
CORS_ORIGINS="http://localhost:3000"
